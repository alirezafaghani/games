                        // اضافه کردن به <head>
                        parentDoc.head.appendChild(styleElement);

                        //console.log(`✅ استایل‌های سفارشی با مقدار سایه: "" به CRM اعمال شد.`);
                    }
                } else {
                    console.log(this.responseText);
                }
            }
        };
        req.send();        
    } catch (e) {
        console.error("❌ خطا در افزودن استایل‌های سفارشی:", e);
    }
}
    function injectBackgroundColorStyleInto(sectioncolor,fieldcolor,bold) {
    let iframes = window.top.document.querySelectorAll('iframe');

    iframes.forEach(function(iframe) {
        iframe.onload = function () {
            const innerDoc = iframe.contentDocument || iframe.contentWindow.document;
            if (!innerDoc) {
                console.error("❌ نمی‌توان به سند داخلی دسترسی پیدا کرد.");
                return;
            }
            // بررسی اینکه استایل قبلاً تزریق شده یا خیر
            if (innerDoc.getElementById("custom_background_style")) {
                //console.log("⚠️ استایل قبلاً اعمال شده است، از اجرای مجدد جلوگیری شد.");
                return; // خروج از تابع، استایل قبلاً اضافه شده است
            }
            if (innerDoc.getElementById("custom_field_style")) {
                //console.log("⚠️ استایل قبلاً اعمال شده است، از اجرای مجدد جلوگیری شد.");
                return; // خروج از تابع، استایل قبلاً اضافه شده است
            }
            if(sectioncolor){
            // بررسی وجود یک عنصر <style> برای استایل‌های مورد نظر (برای جلوگیری از تزریق تکراری)
                if (!innerDoc.getElementById("custom_background_style")) {
                    const styleElement = innerDoc.createElement("style");
                    styleElement.id = "custom_background_style";
                    styleElement.innerHTML = `
                        /* اضافه کردن پس‌زمینه دلخواه به المان‌های ms-crm-FormSection */
                        .refresh-form table.ms-crm-FormSection {
                            background-color:${sectioncolor} !important;
                        }
                        .ms-crm-InlineEditLabel div.ms-crm-Inline-GradientMask, .ms-crm-Inline-Value div.ms-crm-Inline-GradientMask {
                            background: ${sectioncolor} !important;
                        }                                                            
                    `;
                    if (innerDoc.head) {
                        innerDoc.head.appendChild(styleElement);
                    } else {
                        const head = innerDoc.createElement("head");
                        head.appendChild(styleElement);
                        innerDoc.documentElement.insertBefore(head, innerDoc.documentElement.firstChild);
                    }
                    console.log("✅ قانون CSS مربوط به پس‌زمینه به آیفریم تزریق شد.");
                }
            }
            if(fieldcolor){
                if (innerDoc.getElementById("custom_field_style") === null) {
                    const styleElement = innerDoc.createElement("style");
                    styleElement.id = "custom_field_style";
                    if(bold==false){
                        styleElement.innerHTML = `
                        /* تغییر استایل لیبل‌های Inline Edit */
                            .ms-crm-InlineEditLabel span:first-child {
                            color: ${fieldcolor} !important;                            
                            font-size: 14px !important;                       
                        }                        
                            label.ms-crm-List-Sortable {
                            color:${fieldcolor} !important; /* افزودن پس‌زمینه دلخواه */                         
                        }
                            label.ms-crm-List-Sortable {
                            color:${fieldcolor} !important; /* افزودن پس‌زمینه دلخواه */                         
                        }                                                                
                    `;
                    }
                    else if(bold==true){
                        styleElement.innerHTML = `                        
                            .ms-crm-InlineEditLabel span:first-child {
                            color: ${fieldcolor} !important;
                            font-weight: bold !important;
                            font-size: 14px !important;                       
                        }
                            label.ms-crm-List-Sortable {
                            color:${fieldcolor} !important; /* افزودن پس‌زمینه دلخواه */                         
                        }
                            label.ms-crm-List-Sortable {
                            color:${fieldcolor} !important; /* افزودن پس‌زمینه دلخواه */                         
                        }                                                                   
                    `;
                    }                    
                    // اضافه کردن عنصر style به head سند داخلی
                    // توجه کنید که head ممکن است وجود نداشته باشد، پس در صورت نیاز ایجادش کنید
                    if (innerDoc.head) {
                        innerDoc.head.appendChild(styleElement);
                    } else {
                        // در صورتی که head وجود ندارد، آن را ایجاد کرده و اضافه می‌کنیم
                        const head = innerDoc.createElement("head");
                        head.appendChild(styleElement);
                        innerDoc.documentElement.insertBefore(head, innerDoc.documentElement.firstChild);
                    }
                    //console.log("✅ استایل‌های سفارشی به المان‌های ms-crm-InlineEditLabel تزریق شدند.");
                }
            }
        };

        // در صورتی که آیفریم به طور کامل بارگذاری شده باشد، تابع onload را فراخوانی می‌کنیم
        if (iframe.contentDocument && iframe.contentDocument.readyState === "complete") {
            iframe.onload();
        }
    });

    }
function changeLiBackgroundColor() {
        // دریافت تمام `li` هایی که `id` آن‌ها شامل مقدار `searchString` است
        const listItems =window.top.document.querySelectorAll('li[id*="CustomizeUI.Button"]')
    
        listItems.forEach(li => {
            const span = li.querySelector("span");   
            if (span) {
                li.style.padding = "0px";  // حذف پدینگ
                li.style.margin = "0px"; 
                li.style.height = "0px"; 
                li.style.width = "0px"; 
                span.style.backgroundColor = "white";
                span.style.borderColor= "white";
                span.style.padding = "0px";  // حذف پدینگ
                span.style.margin = "0px"; 
            }
        });
}
function loadJQueryAndInjectCss() {
     if (typeof window.jQuery === "undefined") {
         // لود کردن jQuery از Web Resource
         const jqScript = document.createElement("script");
         jqScript.src = "/WebResources/me_JQuery";
         jqScript.onload = () => {
             window.$ = window.jQuery;

             injectCssDirectly();
         };
         document.head.appendChild(jqScript);
     } else {       
         injectCssDirectly();
     }
 }

function observeDomChanges() {
    const observer = new MutationObserver(() => {
        loadJQueryAndInjectCss();
    });

    observer.observe(window.top.document.body, {
        childList: true,
        subtree: true,
    });

    // اجرای اولیه
    loadJQueryAndInjectCss();
}

// اجرای اصلی
if (window.top === window.self) {
    if (document.readyState === "complete") {
        observeDomChanges();
    } else {
        window.addEventListener("load", observeDomChanges);
    }
}
